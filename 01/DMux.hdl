/**
 * 解多路器Demultiplexor:
 ** 关键点：使用sel控制输入值in在a位置或是b位置输出，只能根据sel值在a和b之间二选一输出
 * {a, b} = {in, 0} if sel == 0
 *          {0, in} if sel == 1
 * 思路: out: a = And(in, Not(sel)), b = And(in, sel)
 * and操作 用1 and 谁就返回谁 例如 1 and 1 = 1; 1 and 0 = 0;
 */

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Not(in = sel, out = n1);
    And(a = in, b = n1, out = a);
    And(a = in, b = sel, out = b);
}
